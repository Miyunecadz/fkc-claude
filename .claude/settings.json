{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lodestar-guardrails.py\""
          }
        ]
      },
      {
        "matcher": "mcp__bitbucket__bb_post|mcp__bitbucket__bb_put",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-body.py\" hook",
            "statusMessage": "Validating the PR description"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-msg-oneline.py\"",
            "timeout": 5,
            "statusMessage": "Enforcing one-line commit message"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/graph-context.sh\"",
            "statusMessage": "Resolving architecture maps"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/plain-uk-english.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/uk-english-lint.py\"",
            "statusMessage": "Checking UK English in prose"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/id_ecdsa)",
      "Read(./**/id_dsa)",
      "Read(./**/credentials.json)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Read(./*.p12)",
      "Read(./*.pfx)",
      "Read(./id_rsa)",
      "Read(./id_ed25519)",
      "Read(./id_ecdsa)",
      "Read(./id_dsa)",
      "Read(./credentials.json)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
