# Workspace router repo: only the Claude/Lodestar setup is tracked.
/*
!/.gitignore
!/CLAUDE.md
!/.claude/
!/.lodestar/

# Agent worktrees live under .claude/ but are checkouts, not setup. `!/.claude/` above
# un-ignores everything beneath it, so without this a `git add -A` on the default branch
# would commit an entire working copy of another repo into the router.
.claude/worktrees/

# Python bytecode from the hooks
__pycache__/
*.pyc

# skill-creator run output (answers, grades, viewer, skill snapshot). Test sets live in
# the skill's own evals/ folder; a run is scratch and goes stale on the next edit.
.claude/skills/*-workspace/
